{
  "info": {
    "_postman_id": "3f72bdf8-d307-4554-bac6-c30ed1bb8e72",
    "name": "LectureLink Microservices",
    "description": "LectureLink APIs protected by Keycloak. Provision users and assign INSTITUTE or LECTURER realm roles in Keycloak. Use Postman OAuth 2.0 Authorization Code with PKCE to acquire a token, then set the instituteToken or lecturerToken collection variable. Health endpoints are public.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8072"
    },
    {
      "key": "instituteUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "lecturerUrl",
      "value": "http://localhost:9000"
    },
    {
      "key": "instituteToken",
      "value": ""
    },
    {
      "key": "lecturerToken",
      "value": ""
    },
    {
      "key": "instituteId",
      "value": "1"
    },
    {
      "key": "lecturerId",
      "value": "1"
    },
    {
      "key": "programId",
      "value": "1"
    },
    {
      "key": "subjectId",
      "value": "1"
    },
    {
      "key": "qualificationId",
      "value": "1"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:7080"
    },
    {
      "key": "keycloakRealm",
      "value": "lecturelink"
    },
    {
      "key": "aiMatchUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Keycloak",
      "description": "Create users in the lecturelink realm and assign one realm role. In Postman, use OAuth 2.0 Authorization Code (With PKCE), client ID lecturelink-postman, scope openid, auth URL {{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/auth, token URL {{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token, and callback https://oauth.pstmn.io/v1/callback. Copy an INSTITUTE-role token to instituteToken and a LECTURER-role token to lecturerToken.",
      "item": [
        {
          "name": "OIDC discovery document",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{keycloakRealm}}/.well-known/openid-configuration"
          }
        },
        {
          "name": "Realm signing keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/certs"
          }
        }
      ]
    },
    {
      "name": "Health and discovery",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/actuator/health"
          }
        },
        {
          "name": "Institute service readiness (direct)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{instituteUrl}}/actuator/health/readiness"
          }
        },
        {
          "name": "Lecturer service readiness (direct)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{lecturerUrl}}/actuator/health/readiness"
          }
        },
        {
          "name": "AI match health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{aiMatchUrl}}/health"
          }
        },
        {
          "name": "Eureka home",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8070/"
          }
        },
        {
          "name": "Config server health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8071/actuator/health"
          }
        }
      ]
    },
    {
      "name": "Institute service - authenticated",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{instituteToken}}",
            "type": "string"
          }
        ]
      },

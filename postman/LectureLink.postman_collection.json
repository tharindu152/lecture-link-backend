                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Example Institute\",\n  \"email\": \"institute@example.com\",\n  \"division\": \"Colombo\",\n  \"mapsLocation\": \"Colombo, Sri Lanka\",\n  \"telephone\": \"+94112345678\",\n  \"description\": \"Example institute\",\n  \"logoUrl\": \"https://example.com/logo.png\",\n  \"currentRating\": 0,\n  \"ratingsReceived\": 0,\n  \"subscribed\": false,\n  \"status\": \"ACTIVE\"\n}",
